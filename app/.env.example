# نمونهٔ پیکربندی محیط — هیچ راز واقعی در این فایل قرار ندهید.
# در محیط استقرار، این متغیرها را از سرویس مدیریت اسرار (Secret Manager) تغذیه کنید.
# کپی برای توسعهٔ محلی: cp .env.example .env

# الزامی — رشتهٔ اتصال PostgreSQL (بدون هیچ fallback؛ نبودش باعث شکست بلند می‌شود)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ertf

# محیط اجرا: development | test | production
NODE_ENV=development

# پورت سرور HTTP
PORT=4321

# حداکثر اتصال هم‌زمان به PostgreSQL
DB_POOL_MAX=10

# سطح لاگ: debug | info | warn | error
LOG_LEVEL=info

# نسخهٔ برنامه که در لاگ ساختاریافته ثبت می‌شود (در CI از SHA گیت پر می‌شود)
APP_VERSION=dev
