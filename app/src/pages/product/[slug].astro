---
import AddToCart from '../../components/AddToCart.svelte';
import StockIsland from '../../components/StockIsland.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { productBySlug } from '../../lib/catalog';
import { effectivePrice } from '../../lib/money';
import { formatRials } from '../../lib/format';

const slug = Astro.params.slug ?? '';
const data = await productBySlug(slug);
if (!data) return Astro.redirect('/catalog');
const { product, attributes, availableQuantity } = data;
const price = effectivePrice(product.priceRials, product.discountRials);
---
<BaseLayout title={product.name + ' — ارتِف'}>
  <article class="product-page">
    <img src={product.imageUrl} alt={product.name} width="320" height="320" fetchpriority="high" />
    <div>
      <h1>{product.name}</h1>
      <p>
        {product.brand} — <a href={'/catalog?category=' + product.categorySlug}>{product.categoryName}</a>
        {product.isDigital && <span class="badge">دیجیتال</span>}
      </p>
      <p>{product.description}</p>
      {product.discountRials > 0 && <p class="price-old">{formatRials(product.priceRials)}</p>}
      {/* قطعهٔ تأخیری نسل‌جدید: قیمت و موجودی لحظه‌ای پس از پوستهٔ استاتیک استریم می‌شود */}
      <StockIsland server:defer productId={product.id} priceRials={price}>
        <p slot="fallback" class="price">{formatRials(price)}</p>
      </StockIsland>
      <ul>
        {attributes.map((a) => (
          <li>{a.defName}: {a.valueLabel}{a.defUnit ? ' ' + a.defUnit : ''}</li>
        ))}
      </ul>
      {availableQuantity > 0 && (
        <AddToCart
          client:load
          productId={product.id}
          name={product.name}
          slug={product.slug}
          unitPriceRials={price}
          isDigital={product.isDigital}
        />
      )}
      {product.isDigital && (
        <p class="note">
          این محصول دیجیتال است؛ پس از ثبت سفارش، کد فعال‌سازی نمایش داده می‌شود. انصراف تا پیش از فعال‌سازی لایسنس امکان‌پذیر است.
        </p>
      )}
    </div>
  </article>
</BaseLayout>
