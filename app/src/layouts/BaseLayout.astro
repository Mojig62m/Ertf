---
import CartButton from '../components/CartButton.svelte';
import '../styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site">
      <a class="brand" href="/">ارتِف</a>
      <nav>
        <a href="/catalog">کاتالوگ</a>
      </nav>
      <CartButton client:load />
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">نمونه فنی مرحله دوم ارتِف — پرداخت شبیه‌سازی‌شده</footer>
  </body>
</html>
